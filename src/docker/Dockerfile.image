# Lambda container image for cloudtrail-to-slack.
# Build from the repository root:
#   docker build -f src/docker/Dockerfile.image .
FROM ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 AS uv

# Stage 1: install the runtime dependencies into the Lambda task root
FROM public.ecr.aws/lambda/python:3.15@sha256:b824882f15c6e74f9d21bfe779b28d08688b596699235cd529a79e1d7fd4d121 AS builder

# Compile bytecode for faster cold starts
ENV UV_COMPILE_BYTECODE=1
# Do not write installer metadata, so the layer is deterministic
ENV UV_NO_INSTALLER_METADATA=1
# Copy mode is required for the cache mount
ENV UV_LINK_MODE=copy

# Export the lock file to requirements and install it. The layer is rebuilt
# only when pyproject.toml or uv.lock change.
RUN --mount=from=uv,source=/uv,target=/bin/uv \
    --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=src/pyproject.toml,target=/tmp/src/pyproject.toml \
    --mount=type=bind,source=src/uv.lock,target=/tmp/src/uv.lock \
    cd /tmp/src && \
    uv export --frozen --no-emit-workspace --no-dev --no-editable -o requirements.txt && \
    uv pip install --python-platform linux --target "${LAMBDA_TASK_ROOT}" -r requirements.txt

# Stage 2: final image
FROM public.ecr.aws/lambda/python:3.15@sha256:b824882f15c6e74f9d21bfe779b28d08688b596699235cd529a79e1d7fd4d121

COPY --from=builder --chown=1000:1000 ${LAMBDA_TASK_ROOT} ${LAMBDA_TASK_ROOT}

# Application code only (no tests, no dependency manifests)
COPY --chown=1000:1000 src/*.py ${LAMBDA_TASK_ROOT}/

# Run as a non-root user
USER 1000

CMD ["main.lambda_handler"]
